# Local setup: Docker infrastructure + host-run app in web/.
# Copy to root .env, fill in the three blank secrets, then copy to web/.env.
# These database and storage passwords are local development examples.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=uombot-local-password
POSTGRES_DB=uombot
DATABASE_URL=postgresql://postgres:uombot-local-password@localhost:5432/uombot

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=uombot-documents

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

SIMILARITY_THRESHOLD=0.6
MAX_SOURCES=3
